# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~
.\#*
\#*\#

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node
node_modules/

# Claude Code workspace state — local, not part of the kit. Nothing under .claude/
# is tracked in this repo (the plugin lives under plugins/unifylabs-workflow/), so
# the whole dir is ignored: sessions, projects, phasing/, handoffs/, derisk-scratch/,
# m2 smoke/planning, etc. This supersedes the former piecemeal .claude/* entries.
.claude/

# /phasing-flow run-scratch (local working state; never committed)
.phasing-flow/
.phasing-flow-run/

# Kit's own project manifest from init-project.sh self-bootstrap.
# The kit IS the kit-version source of truth — tracking the manifest would
# create a circular reference.
.unify-kit-project-manifest.json

# Stray
.qodo/

# Secrets — defensive
.env
.env.local
.env.*.local
*.pem
id_rsa*
credentials.json
.aws/credentials
