      "id": "cap-hit-no-criticals",
      "description": "No Criticals throughout; Important set strictly shrinks EVERY round (5 -> 4 -> 3 -> 2), so the fixed-point detector never fires, but a residual remains when the cap is reached -> 'cap' at round 3. (A set that shrinks every round can only hit 'cap', never 'fixed-point'.)",
      "config": {
        "cap": 3,
        "fixedPointK": 1,
        "skipClean": true,
        "includeSuggestions": false,
        "gateImportant": false,
        "budgetTotal": null,
        "relativeMultiplier": 5,
        "absoluteThreshold": 0,
        "initialSpend": 100
      },
      "initialFindings": [
        { "file": "a.js", "line": 1, "severity": "important", "description": "imp-1" },
        { "file": "a.js", "line": 2, "severity": "important", "description": "imp-2" },
        { "file": "a.js", "line": 3, "severity": "important", "description": "imp-3" },
        { "file": "a.js", "line": 4, "severity": "important", "description": "imp-4" },
        { "file": "a.js", "line": 5, "severity": "important", "description": "imp-5" }
      ],
