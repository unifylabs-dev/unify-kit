{
  "$schema-note": "SINGLE SOURCE OF TRUTH for the stopping-engine tests. test/stopping-engine.test.mjs READS this file and generates one node:test per scenario, building deterministic stubs so the JSON and the harness cannot silently drift. NO wall-clock / random anywhere.",
  "harness-contract": {
    "severity": "Each finding's tier derives from numeric `score` (>=90 critical, 80-89 important, <80 suggestion) unless it carries an explicit `severity` string tag that overrides.",
    "reviewRound": "round n (1-indexed) returns rounds[n-1].reviewReturns.",
    "verify": "round n returns rounds[n-1].verify (default 'pass').",
    "budget.spent": "starts at initialSpend (the initial review pass cost, captured by the engine as initialReviewCost). Immediately BEFORE round n's callbacks run, the harness accrues rounds[n-1].spend. Thus the top-of-round budget check for round n sees spend through round n-1.",
    "budget.remaining": "budgetTotal === null ? Infinity : budgetTotal - spent().",
    "budget.total": "budgetTotal (number | null).",
    "expect": "exitReason, roundsRun, residualCritical, residualImportant must match the engine's frozen return."
  },
  "scenarios": [
